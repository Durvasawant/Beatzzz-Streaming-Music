PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Pick ONE (see README.md -> Database setup)
# Local:  mongodb://127.0.0.1:27017/beatzzz
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/beatzzz?retryWrites=true&w=majority
MONGO_URI=

# Clerk (https://dashboard.clerk.com -> API Keys)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# The Clerk account email that should get /admin access
ADMIN_EMAIL=

# Cloudinary - only needed for uploading songs/albums from the admin page
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Spotify (https://developer.spotify.com/dashboard -> Create app). Needed to find the Spotify track for playback.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
